#!/bin/sh
# MagicX RAM Cleaner: pre-commit hook
# Prevents committing code that doesn't pass the fast quality gates.
#
# Install: run scripts/install-hooks.ps1 once after cloning. It points git
# at this folder (core.hooksPath), so edits here take effect immediately.
#
# What it checks:
#   1. cargo fmt --check  (formatting)
#   2. cargo clippy       (lints; deny level from Cargo.toml, warnings denied)
#   3. cargo test         (all tests pass)

set -e

echo "╔══════════════════════════════════════════╗"
echo "║     MagicX Pre-Commit Quality Gate       ║"
echo "╚══════════════════════════════════════════╝"
echo ""

# Gate 1: Formatting
echo "→ Checking formatting..."
if ! cargo fmt --all -- --check; then
    echo ""
    echo "✗ FORMATTING FAILED"
    echo "  Run: cargo fmt"
    echo "  Then try committing again."
    exit 1
fi
echo "  ✓ Formatting OK"

# Gate 2: Clippy (same flags as CI)
echo "→ Running clippy..."
if ! cargo clippy --locked --all-targets -- -D warnings; then
    echo ""
    echo "✗ CLIPPY FAILED"
    echo "  Fix the lint errors above, then try committing again."
    exit 1
fi
echo "  ✓ Clippy OK"

# Gate 3: Tests
echo "→ Running tests..."
if ! cargo test --locked --all-targets; then
    echo ""
    echo "✗ TESTS FAILED"
    echo "  Fix the failing tests, then try committing again."
    exit 1
fi
echo "  ✓ Tests OK"

echo ""
echo "✓ All quality gates passed. Committing..."
