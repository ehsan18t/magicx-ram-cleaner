#!/bin/sh
# MagicX RAM Cleaner: pre-push hook
# Runs the same gates as CI (.github/workflows/ci.yml) before pushing.
# Keep the commands and flags here in step with that file.
#
# Install: run scripts/install-hooks.ps1 once after cloning.
#
# What it checks:
#   1. cargo fmt --check     (formatting)
#   2. cargo clippy          (lints)
#   3. cargo test            (all tests pass)
#   4. cargo bench --no-run  (benchmarks compile)
#   5. cargo build           (debug build compiles)
#   6. cargo doc             (documentation builds, same rustdoc lints as CI)
#   7. cargo deny check      (dependency audit, if cargo-deny is installed)

set -e

echo "╔══════════════════════════════════════════╗"
echo "║     MagicX Pre-Push Quality Gate         ║"
echo "╚══════════════════════════════════════════╝"
echo ""

fail() {
    echo ""
    echo "✗ $1 FAILED"
    echo "  Fix the errors above, then try pushing again."
    exit 1
}

echo "→ [1/7] Checking formatting..."
cargo fmt --all -- --check || fail "FORMATTING"
echo "  ✓ Formatting OK"

echo "→ [2/7] Running clippy..."
cargo clippy --locked --all-targets -- -D warnings || fail "CLIPPY"
echo "  ✓ Clippy OK"

echo "→ [3/7] Running tests..."
cargo test --locked --all-targets || fail "TESTS"
echo "  ✓ Tests OK"

echo "→ [4/7] Compiling benchmarks..."
cargo bench --locked --no-run || fail "BENCHMARK BUILD"
echo "  ✓ Benchmarks OK"

echo "→ [5/7] Building debug binary..."
cargo build --locked || fail "DEBUG BUILD"
echo "  ✓ Debug build OK"

echo "→ [6/7] Building docs..."
RUSTDOCFLAGS="-D warnings -D rustdoc::bare_urls -D rustdoc::invalid_rust_codeblocks -D rustdoc::private_intra_doc_links -D rustdoc::unescaped_backticks" \
    cargo doc --locked --no-deps || fail "DOCUMENTATION BUILD"
echo "  ✓ Docs OK"

echo "→ [7/7] Auditing dependencies..."
if command -v cargo-deny >/dev/null 2>&1; then
    cargo deny check || fail "DEPENDENCY AUDIT"
    echo "  ✓ Dependency audit OK"
else
    echo "  ⊘ cargo-deny not installed, skipping (install: cargo install cargo-deny)"
fi

echo ""
echo "✓ All quality gates passed. Pushing..."
